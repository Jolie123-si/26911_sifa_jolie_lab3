<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!--
      DATABASE
      The database is a SQLite file stored in the project folder: Data\Database\RoomManagement.db
      Nothing needs to be installed: the file is created automatically the first time the app runs.
    -->
    <add key="DatabaseFileName" value="RoomManagement.db" />

    <!-- Password given to new accounts (Sign Up). The user must change it at first sign in. -->
    <add key="DefaultPassword" value="RRA@2024" />

    <!--
      EMAIL (used by "Forgot password?" to send the reset code, and by Sign Up to send the default password)
      EmailEnabled = false : the reset code is shown on the screen (good for testing without internet).
      EmailEnabled = true  : the reset code is sent by email. Fill in your Gmail address and a Gmail
                             "App password" (Google account > Security > App passwords).
    -->
    <add key="EmailEnabled" value="false" />
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="" />
    <add key="SmtpPassword" value="" />
  </appSettings>
</configuration>
